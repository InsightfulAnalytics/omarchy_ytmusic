#!/bin/bash
# Start, stop and inspect the detached mpv player used by tim.ytmusic.
#
# mpv runs in its own systemd user unit so playback survives plugin hot
# reloads and shell restarts. The shell talks to it over the JSON IPC socket.
#
# mpv never runs yt-dlp (--ytdl=no) and never holds the session's cookies:
# the worker resolves every stream in-process and mpv/ytm-streams.lua plays
# it, asking the shell for one when a track has none yet. yt-dlp under mpv
# would put each video id on a command line every local account can read.
#
# Memory: mpv itself stays around 70-80 MiB; MemoryMax guards against runaways.
#
#   ytm-mpv start [--volume N]   start the unit (no-op if already running)
#   ytm-mpv stop                 stop the unit
#   ytm-mpv status               print unit state and socket path
#   ytm-mpv socket               print the IPC socket path
#   ytm-mpv cookies              remove the copy of the session's cookies older
#                                versions kept for mpv (it needs none now)
#   ytm-mpv exec [--volume N]
#                                run mpv in the foreground (used by the unit)
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
UNIT=omarchy-ytmusic-mpv
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-ytmusic"
SOCKET="$RUNTIME_DIR/mpv.sock"
# The copy of the session's cookies older versions gave mpv's yt-dlp.
LEGACY_COOKIES="$RUNTIME_DIR/cookies-mpv.txt"

MPRIS=/etc/mpv/scripts/mpris.so
[[ -f $MPRIS ]] || MPRIS=/usr/lib/mpv-mpris/mpris.so

cmd=${1:-}
[[ $# -gt 0 ]] && shift

volume=70
while (( $# > 0 )); do
  case $1 in
  --volume)
    volume=${2:-70}
    shift 2
    ;;
  --quality)
    # Older shells pass the audio quality; the worker picks the format now.
    shift 2
    ;;
  *)
    echo "ytm-mpv: unknown option: $1" >&2
    exit 2
    ;;
  esac
done
[[ $volume =~ ^[0-9]+$ ]] || volume=70

drop_legacy_cookies() {
  rm -f -- "$LEGACY_COOKIES" "$LEGACY_COOKIES".* 2>/dev/null || true
}

start() {
  systemctl --user is-active --quiet "$UNIT" && return 0
  systemctl --user reset-failed "$UNIT" 2>/dev/null || true
  systemd-run --user --quiet --collect --unit="$UNIT" \
    --description="omarchy-ytmusic player" \
    -p RuntimeDirectory=omarchy-ytmusic -p RuntimeDirectoryMode=0700 \
    -p MemoryMax=768M \
    -E PATH="$PATH" \
    -- "$ROOT/bin/ytm-mpv" exec --volume "$volume"
}

run_mpv() {
  drop_legacy_cookies
  local -a args=(
    --no-config
    # mpv leaves certificate checks off by default (and --no-config drops any
    # user setting), so without this a network interceptor could swap the audio.
    --tls-verify=yes
    --script="$ROOT/mpv/ytm-idle.lua"
    --script="$ROOT/mpv/ytm-streams.lua"
    --script="$ROOT/mpv/ytm-levels.lua"
    --script-opts=ytm-idle-idle_secs=300,ytm-idle-pause_secs=1800
    --idle=yes
    --no-video
    --force-window=no
    --no-terminal
    --msg-level=all=warn
    --input-ipc-server="$SOCKET"
    # No yt-dlp under mpv (see the top of this file).
    --ytdl=no
    --cache=yes
    --demuxer-max-bytes=8MiB
    --demuxer-max-back-bytes=4MiB
    --audio-client-name=omarchy-ytmusic
    --volume="$volume"
    --osc=no
    --load-stats-overlay=no
    --load-console=no
    --load-osd-console=no
    --load-auto-profiles=no
    --load-select=no
    --load-positioning=no
    --load-commands=no
    --load-context-menu=no
  )
  # Media keys and the OSD follow the player over MPRIS (package mpv-mpris).
  if [[ -f $MPRIS ]]; then
    args+=(--script="$MPRIS")
  fi
  exec mpv "${args[@]}"
}

case $cmd in
start) start ;;
stop) systemctl --user stop "$UNIT" 2>/dev/null || true ;;
status)
  printf 'unit: %s\nsocket: %s\n' "$(systemctl --user is-active "$UNIT" 2>/dev/null || true)" "$SOCKET"
  ;;
socket) echo "$SOCKET" ;;
cookies) drop_legacy_cookies ;;
exec) run_mpv ;;
*)
  echo "usage: ytm-mpv <start|stop|status|socket|cookies|exec> [--volume N]" >&2
  exit 2
  ;;
esac
